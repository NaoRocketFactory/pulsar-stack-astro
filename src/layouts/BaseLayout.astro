---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { defaultLocale, languages, localizePath, useTranslations, type Locale } from '../i18n/utils';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	locale?: Locale;
	type?: 'website' | 'article';
}

const { title, description, image, locale = defaultLocale, type = 'website' } = Astro.props;

const t = useTranslations(locale);
const pageTitle = title ? `${title} · ${t.meta.siteName}` : t.meta.defaultTitle;
const pageDescription = description ?? t.meta.defaultDescription;

const currentPath = Astro.url.pathname;
const unlocalizedPath = currentPath.replace(new RegExp(`^/(${Object.keys(languages).join('|')})(?=/|$)`), '') || '/';

const navLinks = t.navbar.links.map((link) => ({
	label: link.label,
	href: localizePath(link.href, locale),
}));

const footerLinks = t.footer.links.map((link) => ({
	label: link.label,
	href: /^[a-z]+:/i.test(link.href) ? link.href : localizePath(link.href, locale),
}));
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>

		<SEO title={pageTitle} description={pageDescription} image={image} locale={locale} type={type} />

		{
			Object.keys(languages).map((lang) => (
				<link rel="alternate" hreflang={lang} href={new URL(localizePath(unlocalizedPath, lang as Locale), Astro.site ?? Astro.url.origin)} />
			))
		}
		<link
			rel="alternate"
			hreflang="x-default"
			href={new URL(unlocalizedPath, Astro.site ?? Astro.url.origin)}
		/>

		<link rel="sitemap" href="/sitemap-index.xml" />

		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem('theme');
					var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
					var theme = stored || (prefersDark ? 'dark' : 'light');
					document.documentElement.classList.toggle('dark', theme === 'dark');
					document.documentElement.classList.toggle('light', theme === 'light');
					document.documentElement.setAttribute('data-theme', theme);
				} catch (e) {}
			})();
		</script>
	</head>
	<body>
		<a href="#main-content" class="sr-only">Skip to content</a>
		<Navbar
			links={navLinks}
			buyLabel={t.navbar.buyLabel}
			buyHref={t.navbar.buyHref}
			locale={locale}
			siteName={t.meta.siteName}
		/>
		<main id="main-content">
			<slot />
		</main>
		<Footer
			siteName={t.meta.siteName}
			links={footerLinks}
			tagline={t.footer.tagline}
			navigateLabel={t.footer.columns.navigate}
			contactLabel={t.footer.contact.title}
			contactEmail={t.footer.contact.email}
			rightsLabel={t.footer.rights}
		/>
	</body>
</html>
