---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';

const locale = 'en' as const;
const t = useTranslations(locale);
---

<BaseLayout locale={locale}>
	<section class="hero">
		<div class="container hero-inner">
			<div class="hero-logo">
				<div class="hero-logo-inner">
					<img src="/logo/pulsar-stack-cut.png" alt="Pulsar Stack" class="hero-logo-img" width="120" height="120" />
				</div>
			</div>
			<p class="eyebrow">{t.hero.eyebrow}</p>
			<h1>{t.hero.title}</h1>
			<p class="hero-subtitle">{t.hero.subtitle}</p>
			<div class="hero-actions">
				<a href="/about" class="btn btn-primary">{t.hero.ctaSecondary}</a>
			</div>
		</div>
	</section>

	<section class="section features">
		<div class="container">
			<p class="eyebrow">{t.features.eyebrow}</p>
			<h2>{t.features.title}</h2>
			<div class="features-grid">
				{
					t.features.items.map((item) => (
						<article class="card feature-card">
							<h3>{item.title}</h3>
							<p class="text-muted">{item.description}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section cta-section">
		<div class="container cta-inner">
			<h2>{t.cta.title}</h2>
			<p class="text-muted">{t.cta.subtitle}</p>
			<a href={t.cta.buttonHref} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
					{t.cta.button}
				</a>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		padding-block: var(--space-16) var(--space-12);
		border-bottom: 1px solid var(--border);
	}

	.hero-inner {
		max-width: 54rem;
		margin-inline: auto;
		text-align: center;
	}

	.hero h1 {
		font-size: var(--fs-5xl);
		margin-bottom: var(--space-5);
	}

	.hero-subtitle {
		max-width: 36rem;
		margin-inline: auto;
		font-size: var(--fs-lg);
		color: var(--text-muted);
		line-height: var(--lh-relaxed);
		margin-bottom: var(--space-6);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-3);
	}

	.hero-logo {
		display: flex;
		justify-content: center;
		margin-bottom: var(--space-5);
	}

	.hero-logo-inner {
		position: relative;
		display: inline-flex;
	}

	.hero-logo-inner::before {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		width: 280px;
		height: 280px;
		transform: translate(-50%, -50%);
		background: radial-gradient(circle, color-mix(in srgb, var(--accent) 32%, transparent) 0%, transparent 72%);
		filter: blur(32px);
		z-index: -1;
		pointer-events: none;
	}

	.hero-logo-img {
		height: 120px;
		width: auto;
		background: transparent;
		filter: drop-shadow(0 10px 28px color-mix(in srgb, var(--accent) 55%, transparent));
		animation: hero-logo-float 6s ease-in-out infinite;
	}

	@keyframes hero-logo-float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-14px);
		}
	}

	.features h2 {
		font-size: var(--fs-3xl);
		margin-bottom: var(--space-8);
		max-width: 32rem;
	}

	.features-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-5);
	}

	.feature-card h3 {
		font-size: var(--fs-lg);
		margin-bottom: var(--space-2);
	}

	.feature-card:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
		border-color: var(--accent);
	}

	.cta-section {
		text-align: center;
		background: var(--surface);
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}

	.cta-inner {
		max-width: 34rem;
		margin-inline: auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-3);
	}

	.cta-inner h2 {
		font-size: var(--fs-3xl);
	}

	.cta-inner .btn {
		margin-top: var(--space-3);
	}

	@media (max-width: 860px) {
		.features-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.hero h1 {
			font-size: var(--fs-4xl);
		}

		.features-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
