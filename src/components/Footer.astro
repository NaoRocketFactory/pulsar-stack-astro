---
interface FooterLink {
	label: string;
	href: string;
}

interface Props {
	siteName: string;
	links: FooterLink[];
	tagline?: string;
	navigateLabel?: string;
	contactLabel?: string;
	contactEmail?: string;
	rightsLabel?: string;
	builtWith?: string;
	builtWithHref?: string;
}

const {
	siteName,
	links,
	tagline,
	navigateLabel = 'Navigate',
	contactLabel = 'Contact',
	contactEmail,
	rightsLabel = 'All rights reserved.',
	builtWith,
	builtWithHref,
} = Astro.props;

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div class="footer-brand">
			<p class="brand-name">{siteName}</p>
			{tagline && <p class="text-muted">{tagline}</p>}
			{
				builtWith && builtWithHref && (
					<a class="built-with" href={builtWithHref} target="_blank" rel="noopener noreferrer">
						<svg class="astro-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
							<path
								d="M12 2.4c-.33 0-.62.2-.75.51L5.62 18.9a.75.75 0 0 0 .7 1.02h1.8a.75.75 0 0 0 .71-.5l.6-1.75h5.14l.6 1.75a.75.75 0 0 0 .71.5h1.8a.75.75 0 0 0 .7-1.02L12.75 2.91a.8.8 0 0 0-.75-.51Zm0 5.1 1.73 5.06h-3.46L12 7.5Z"
								fill="currentColor"
							/>
							<path
								d="M8.83 21.2c.57.62 1.43.98 3.17.98s2.6-.36 3.17-.98a.35.35 0 0 0-.36-.57c-.83.28-1.75.43-2.81.43s-1.98-.15-2.81-.43a.35.35 0 0 0-.36.57Z"
								fill="currentColor"
								opacity=".55"
							/>
						</svg>
						{builtWith}
					</a>
				)
			}
		</div>

		<nav aria-label={navigateLabel}>
			<p class="footer-heading">{navigateLabel}</p>
			<ul>
				{
					links.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div>
			<p class="footer-heading">{contactLabel}</p>
			{
				contactEmail && (
					<a class="footer-email" href={`mailto:${contactEmail}`}>
						{contactEmail}
					</a>
				)
			}
		</div>
	</div>

	<div class="container footer-bottom">
		<p class="text-muted">© {year} {siteName}. {rightsLabel}</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--border);
		background: var(--surface);
		padding-block-start: var(--space-10);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: var(--space-8);
		padding-block-end: var(--space-8);
	}

	.footer-brand .brand-name {
		font-weight: 800;
		font-size: var(--fs-lg);
		margin-bottom: var(--space-2);
	}

	.footer-heading {
		font-size: var(--fs-sm);
		font-weight: 700;
		margin-bottom: var(--space-3);
	}

	.site-footer ul {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.site-footer a {
		text-decoration: none;
		color: var(--text-muted);
		font-size: var(--fs-sm);
		transition: color var(--transition-fast);
	}

	.site-footer a:hover {
		color: var(--text);
	}

	.footer-email {
		display: inline-block;
	}

	.built-with {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		margin-top: var(--space-3);
		font-size: var(--fs-sm);
	}

	.astro-icon {
		color: #bc52ee;
	}

	.footer-bottom {
		border-top: 1px solid var(--border);
		padding-block: var(--space-5);
	}

	.footer-bottom p {
		font-size: var(--fs-xs);
	}

	@media (max-width: 640px) {
		.footer-grid {
			grid-template-columns: 1fr;
			gap: var(--space-6);
		}
	}
</style>
